# Local database. The V2 starter uses SQLite so it runs immediately.
DATABASE_PATH=./data/facecan.db

# Application
APP_NAME=FACECAN Ponto Digital
ADMIN_EMAIL=admin@empresa.local
ADMIN_PASSWORD=change-this-before-production

# Security
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional production integrations
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEWS_SYSTEMS_BASE_URL=
NEWS_SYSTEMS_API_KEY=
ORACLE_EXPORT_DIRECTORY=
